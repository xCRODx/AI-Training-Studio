# =======================================================
# Arquitetura do Modelo Base (Exemplo Simples e Funcional)
# =======================================================
MODEL_D_MODEL=512
MODEL_LAYERS=12
MODEL_EXPERTS=1
MODEL_NUM_HEADS=0
MODEL_HEAD_DIM=64
MODEL_FFN_HIDDEN_SIZE=0
MODEL_FFN_MULTIPLIER=4.0
MODEL_FFN_MULTIPLE_OF=64
MODEL_NORM_EPS=1e-6
MODEL_INIT_STD=0.02
CONTEXT_WINDOW=512

# =======================================================
# Seleção independente de arquitetura e quantização
# =======================================================
# BitNet (quantização dos pesos) e RetNet (arquitetura de sequência) são independentes.
# Ative uma, ambas ou nenhuma, conforme o modelo e a implementação utilizados.
# USE_BITNET=true  + USE_RETNET=true  -> BitNet + RetNet
# USE_BITNET=true  + USE_RETNET=false -> BitNet com atenção Transformer
# USE_BITNET=false + USE_RETNET=true  -> RetNet com projeções convencionais
# USE_BITNET=false + USE_RETNET=false -> Transformer convencional
#
# Ambas falsas selecionam a combinação Transformer convencional.
USE_BITNET=false
USE_RETNET=false
# GQA (opcional, apenas transformer/bitnet): nº de KV heads. 0 = automático.
MODEL_KV_HEADS=0
# RoPE (apenas transformer/bitnet): frequência base.
ROPE_THETA=10000.0

# =======================================================
# Desempenho e Treinamento (Ajustado para GPUs comuns)
# =======================================================
TRAIN_BATCH_SIZE=4
GRADIENT_ACCUMULATION_STEPS=8
TRAIN_LR=3.0e-4
TRAIN_EPOCHS=1
CHECKPOINT_SAVE_STEPS=500
MAX_GRAD_NORM=1.0
TRAIN_PRECISION=bf16
USE_8BIT_OPTIMIZER=true
OPTIMIZER_BETA1=0.9
OPTIMIZER_BETA2=0.95
OPTIMIZER_EPS=1e-6
VALIDATION_EVAL_STEPS=50
METRICS_LOG_STEPS=10
METRICS_ACCURACY_SAMPLE_TOKENS=1000
METRICS_PREVIEW_TOKENS=30
DATASET_ESTIMATION_SAMPLES=100
# false = uma única passagem; true permite repetir o dataset ao chegar ao fim.
REPEAT_DATASET=false

# =======================================================
# Tokenizer e Dataset de Pré-treino
# =======================================================
# Dispositivo preferencial (cuda ou cpu)
INFERENCE_DEVICE=cuda
INFERENCE_AUTO_TEMPERATURE=0.7
INFERENCE_AUTO_TOP_P=0.9
INFERENCE_AUTO_TOP_K=50
INFERENCE_AUTO_REPETITION_PENALTY=1.05

# Tokenizer inglês causal com byte fallback (Unicode/PT-BR sem UNK).
TOKENIZER_NAME=TinyLlama/TinyLlama-1.1B-intermediate-step-1431k-3T
TOKENIZER_REVISION=59f6f375b26bde864a6ca194a9a3044570490064
DATASET_NAME=HuggingFaceTB/cosmopedia
DATASET_CONFIG_NAME=web_samples_v1
DATASET_REVISION=0ae6ec63f91742bd2d1eaef4f02232c55d719385
DATASET_SPLIT=train
DATASET_TEXT_FIELD=text
DATASET_QUALITY_FIELD=
DATASET_QUALITY_VALUE=

# Caminhos e política de validação não dependem do tamanho do modelo.
# Vazio: usa sempre checkpoints/base.
CHECKPOINT_DIR=
VALIDATION_HOLDOUT_FRACTION=0.005
VALIDATION_BATCHES=8

# Insira seu Token de Leitura (Read) do Hugging Face aqui caso o dataset seja privado ou exija aceite
HF_TOKEN=

# =======================================================
# Fine-Tuning Conversacional (SFT)
# =======================================================
FINE_TUNING_ENGINE=local
# full preserva o fluxo histórico; lora congela o modelo-base e treina adaptadores.
FINE_TUNING_METHOD=full
FINE_TUNING_LORA_RANK=16
FINE_TUNING_LORA_ALPHA=32
FINE_TUNING_LORA_DROPOUT=0.05
FINE_TUNING_LORA_TARGET_MODULES=q_proj,k_proj,v_proj,out_proj,g_proj,gate_proj,up_proj,down_proj,fc1,fc2
# Vazio: herda o CHECKPOINT_DIR efetivo do pré-treino.
FINE_TUNING_SOURCE_DIR=
# Vazio: checkpoints_finetuning (a compilação lê base_finetuning dentro dele).
FINE_TUNING_ROOT_DIR=
FINE_TUNING_DATA_DIR=data/finetuning_en_smoltalk
FINE_TUNING_DATASET_NAME=HuggingFaceTB/smoltalk
FINE_TUNING_DATASET_CONFIG=all
FINE_TUNING_DATASET_REVISION=5feaf2fd3ffca7c237fc38d1861bc30365d48ffa
FINE_TUNING_TRAIN_SPLIT=train
FINE_TUNING_VALIDATION_SPLIT=
FINE_TUNING_VALIDATION_FRACTION=0.01
FINE_TUNING_MESSAGES_FIELD=messages
FINE_TUNING_MAX_TRAIN_SAMPLES=20000
FINE_TUNING_MAX_VALIDATION_SAMPLES=1000
FINE_TUNING_MICRO_BATCH_SIZE=2
FINE_TUNING_GLOBAL_BATCH_SIZE=16
FINE_TUNING_GRADIENT_ACCUMULATION_STEPS=8
FINE_TUNING_LEARNING_RATE=2e-5
FINE_TUNING_EPOCHS=2
FINE_TUNING_PRECISION=bf16
FINE_TUNING_USE_8BIT_OPTIMIZER=true
FINE_TUNING_MAX_CHECKPOINTS=5
FINE_TUNING_METRICS_ACCURACY_SAMPLE_TOKENS=2048
FINE_TUNING_WEIGHT_NORM_STEPS=25
FINE_TUNING_TERNARY_METRICS_STEPS=100
FINE_TUNING_OPTIMIZER_BETA1=0.9
FINE_TUNING_OPTIMIZER_BETA2=0.95
FINE_TUNING_OPTIMIZER_EPS=1e-6
FINE_TUNING_SYSTEM_PROMPT="You are a helpful, concise and friendly assistant. Answer the user's request directly and stop when the answer is complete."
